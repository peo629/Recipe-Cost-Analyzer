{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test": "tsx scripts/src/run-tests.ts unit",
    "test:unit": "tsx scripts/src/run-tests.ts unit",
    "test:integration": "tsx scripts/src/run-tests.ts integration",
    "test:e2e": "tsx scripts/src/run-tests.ts e2e",
    "test:smoke": "tsx scripts/src/run-tests.ts smoke",
    "test:quality": "tsx scripts/src/run-tests.ts quality",
    "test:all": "tsx scripts/src/run-tests.ts all"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.5",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "catalog:",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "tsx": "catalog:",
    "typescript": "~5.9.2",
    "vitest": "^4.1.5"
  }
}
